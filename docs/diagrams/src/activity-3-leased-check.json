  "cards": [
    {
      "dot": "cyan",
      "title": "Why leases",
      "items": [
        "Most checks never reach Redis: each instance holds a small chunk of the bucket and takes from it with one CAS",
        "Over-admission is bounded: at most N instances x one chunk C"
      ]
    },
    {
      "dot": "slate",
      "title": "Exact path cases",
      "items": [
        "Rules marked strict, rules whose limit comes from a customer's plan, a cost above one chunk, a full lease table"
      ]
    },
    {
      "dot": "amber",
      "title": "Chunk size",
      "items": [
        "Grows when waiters emptied the lease, halves after 10 s idle, between 8 and the cap"
      ]
    }
  ]
