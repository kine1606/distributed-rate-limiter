  "cards": [
    {
      "dot": "cyan",
      "title": "Why the change is immediate",
      "items": [
        "The plan hash is the only copy of the terms; caches are dropped by message, not by waiting",
        "A message missed while a subscription was down is covered by the 5 s cache TTL and a full drop on resubscribing"
      ]
    },
    {
      "dot": "amber",
      "title": "Same path for every change",
      "items": [
        "Plans, custom limits, boosts, top-ups, suspension: one script on the plan hash, then the message"
      ]
    }
  ]
