  "cards": [
    {
      "dot": "rose",
      "title": "What is never retried",
      "items": [
        "A quota script: a timed-out one may have counted the call, so a retry would count it twice, or come back replayed and never be billed",
        "A token return"
      ]
    },
    {
      "dot": "cyan",
      "title": "The breaker",
      "items": [
        "One per slot group, so a dead master stops calls to its own slots only",
        "20 failures in a row open it; after 500 ms one probe goes out; its success closes it",
        "An error reply (MOVED, a script error) means Redis answered: it does not count"
      ]
    },
    {
      "dot": "amber",
      "title": "The failure answer",
      "items": [
        "Fail open (paid plans): allowed, reason UNVERIFIED, not billed",
        "Fail closed (Free): denied, reason UNAVAILABLE"
      ]
    }
  ]
