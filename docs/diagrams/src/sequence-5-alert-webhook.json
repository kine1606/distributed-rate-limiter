  "cards": [
    {
      "dot": "cyan",
      "title": "Delivery rules",
      "items": [
        "Retried on errors and 5xx, with backoff; never on a refusal (4xx other than 429)",
        "The URL is checked again before each attempt: no private, loopback or reserved addresses"
      ]
    },
    {
      "dot": "amber",
      "title": "If the notifier is down",
      "items": [
        "Pub/Sub keeps no messages, so that alert is lost; the merchant can still read usage.alerts from GET /v1/customers/{id}"
      ]
    }
