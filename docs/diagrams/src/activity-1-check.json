  "cards": [
    {
      "dot": "cyan",
      "title": "Other rules",
      "items": [
        "A rule without a plan, such as api_default, skips this path and is served from local leases (LeasedCore)",
        "CheckBatch sends every entry down the same path, under one merchant"
      ]
    },
    {
      "dot": "amber",
      "title": "Alerts",
      "items": [
        "quota.lua publishes on rl-alerts at 80%, at the limit, at the first overage and at the first denial, once a period",
        "control/rlcontrol/notifier.py signs and delivers them to the merchant's webhook"
      ]
    },
    {
      "dot": "rose",
      "title": "After a quota denial",
      "items": [
        "The burst token goes back to the bucket",
        "The denial is cached until the reset, so the next calls never reach Redis"
      ]
    }
  ]
