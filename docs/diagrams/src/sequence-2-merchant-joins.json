  "cards": [
    {
      "dot": "cyan",
      "title": "Two keys, two jobs",
      "items": [
        "The check key only lets a gateway ask the limiter",
        "The management key only manages acme's own plans and customers: a leaked gateway key cannot change limits"
      ]
    },
    {
      "dot": "rose",
      "title": "Revoking",
      "items": [
        "DELETE /v1/merchants/acme/check-keys removes the hashes and publishes !merchants: every limiter refuses the key on its next call"
      ]
    }
  ]
